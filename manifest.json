{
  "manifest_version": 3,
  "name": "Highlighting Translate",
  "version": "1.16.0",
  "description": "Translate selected text automatically with smart language detection",
  "permissions": [
    "contextMenus",
    "storage",
    "tts",
    "scripting"
  ],
  "optional_permissions": [
    "notifications",
    "alarms"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["services/TranslationService.js", "services/StorageService.js", "services/HighlightService.js", "services/TooltipService.js", "services/FocusTrackService.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "翻譯設定"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/frequency_db.json", "assets/fallback_words.json", "assets/phrasal_verbs_db.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
